# Database
DATABASE_URL=postgresql://meteo:meteo@localhost:5432/meteo

# MinIO (S3-compatible bronze layer)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=meteo-bronze
USE_LOCAL_BRONZE=false  # Set to true to store raw JSON on local disk instead of MinIO
LOCAL_BRONZE_PATH=./data/bronze

# OpenWeather backup (optional)
OPENWEATHER_API_KEY=

# Locations + alerts config
LOCATIONS_CONFIG=config/locations.yaml
ALERTS_CONFIG=config/alerts.yaml

# Prefect (Approach 1)
PREFECT_API_URL=http://localhost:4200/api

# Kafka / Redpanda (Approach 2)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_OBSERVATIONS=weather.observations
KAFKA_TOPIC_ALERTS=weather.alerts
KAFKA_CONSUMER_GROUP=meteo-stream-consumer
KAFKA_CONSUMER_GROUP_ALERTS=meteo-stream-alerter
PRODUCER_POLL_INTERVAL_SECONDS=600

# Alerting (Approach 2)
ALERT_COOLDOWN_SECONDS=1800
ALERT_WEBHOOK_URL=

# Model-centric (Approach 3)
GFS_S3_BUCKET=noaa-gfs-bdp-pds
GFS_MODEL=gfs
NWP_FORECAST_HOURS=48
MODEL_DIR=./models
# Minimum matched (forecast, observation) pairs before a bias model is trained;
# below this the correction passes raw GFS through unchanged.
BIAS_CORRECTION_MIN_SAMPLES=300

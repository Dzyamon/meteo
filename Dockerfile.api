# FastAPI serving layer (predictions + dashboard). Core deps only — no GRIB
# tooling needed to serve, so this stays small and fast to build.
FROM python:3.11-slim

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY config ./config
RUN pip install --no-cache-dir -e "."

EXPOSE 8000
CMD ["meteo-serve"]
